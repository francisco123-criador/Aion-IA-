DATABASE_URL=postgres://postgres:postgres@localhost:5432/aion
LOG_DIR=./aion

# ── Servidor de IA (obrigatório para o chat funcionar) ───────────────────────
# Endereço do gateway de chat (já inclui /v1). Fornecido pela plataforma.
BTY_LLM_SERVER_BASE_URL=COLOQUE_AQUI_A_URL_DO_GATEWAY
# Chave de acesso do servidor de IA.
BTY_LLM_SERVER_API_KEY=COLOQUE_AQUI_A_CHAVE

# ── URL pública da Aion (usada pelo APK via Capacitor) ────────────────────────
AION_PUBLIC_URL=https://SEU-DOMINIO-DA-AION.com

# Reactus / HappySeeds (para media e integração, quando aplicável)
REACTUS_BASE_URL=https://reactus-api.happyseeds.ai
HAPPYSEEDS_PROJECT_ID=

# Umami Analytics (opcional)
NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://your-umami-domain/script.js"
NEXT_PUBLIC_UMAMI_WEBSITE_ID="your-website-id"
